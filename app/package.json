{
  "name": "wikendo-web-app",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "cd .. && husky app/.husky || true",
    "lint:js": "eslint . --max-warnings 0",
    "lint:prettier": "prettier --check .",
    "lint": "pnpm lint:js && pnpm lint:prettier",
    "lint:fix": "prettier --write --list-different . && pnpm run lint:js --fix",
    "type-check": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:seed": "cd ../supabase && python3 -m pytest tests/ -q",
    "test:related": "vitest related --run --passWithNoTests"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "@pinia/nuxt": "^1.0.3",
    "@supabase/supabase-js": "2.117.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-dompurify-html": "^5.3.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  }
}

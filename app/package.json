    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}

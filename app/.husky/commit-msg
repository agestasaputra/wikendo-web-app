# commit-msg — Conventional Commits: type(scope)?: subject. Tipe = yang sudah dipakai repo ini.
# Contoh: feat(voucher): klaim 3 row | fix(auth): redirect google | docs(progress): ... | design(board): ...
FIRST=$(head -n 1 "$1")
case "$FIRST" in Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;; esac
if ! printf '%s' "$FIRST" | grep -Eq '^(feat|fix|docs|design|refactor|test|chore|perf|style|ci|build|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "✖ Pesan commit tidak sesuai Conventional Commits."
  echo "  Format : type(scope): subject   — tipe: feat fix docs design refactor test chore perf style ci build revert"
  echo "  Contoh : feat(voucher): klaim 3 row"
  echo "  Kamu   : $FIRST"
  exit 1
fi
